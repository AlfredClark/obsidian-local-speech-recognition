{
  "name": "obsidian-local-speech-recognition",
  "version": "0.5.2",
  "description": "Use the locally deployed sherpa-onnx service to realize offline speech recognition in your notes.",
  "license": "GPL-3.0-only",
  "author": "Alfred Clark",
  "homepage": "https://github.com/AlfredClark/obsidian-local-speech-recognition",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfredClark/obsidian-local-speech-recognition.git"
  },
  "bugs": {
    "url": "https://github.com/AlfredClark/obsidian-local-speech-recognition/issues"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "speech-recognition",
    "offline",
    "sherpa-onnx"
  ],
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "bun esbuild.config.ts",
    "build": "tsc -noEmit -skipLibCheck && bun scripts/svelte-check.ts && bun esbuild.config.ts production",
    "test": "bun test --preload ./tests/setup.ts tests",
    "lint": "eslint .",
    "format": "prettier --write . && stylelint \"**/*.css\" --fix",
    "format:check": "prettier --check . && stylelint \"**/*.css\"",
    "version": "bun scripts/version-bump.ts && git add manifest.json versions.json",
    "link": "bun scripts/link-dist.ts --hotreload",
    "unlink": "bun scripts/unlink-dist.ts"
  },
  "devDependencies": {
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "pinyin-pro": "^3.29.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.3.2",
    "devalue": "^5.9.2"
  }
}
